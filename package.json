{
  "name": "siteos",
  "private": true,
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "verify": "node fixtures/verify.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "check": "pnpm verify && pnpm typecheck && pnpm coverage",
    "whatsapp:mcp": "pnpm --filter @siteos/whatsapp-channel mcp",
    "whatsapp:serve": "pnpm --filter @siteos/whatsapp-channel serve"
  },
  "devDependencies": {
    "@types/node": "^26.3.0",
    "@vitest/coverage-v8": "^2.1.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
