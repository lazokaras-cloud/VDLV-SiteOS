# WhatsApp Cloud API (Meta). Leave blank to use WhatsApp Web QR pairing instead.
WHATSAPP_MODE=web
WHATSAPP_GROUP_SUBJECT=SiteOS Cursor
WHATSAPP_GROUP_JID=
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_DISPLAY_NUMBER=
WHATSAPP_ALLOWED_SENDERS=
# WHATSAPP_ALLOW_ALL_SENDERS=false
# WHATSAPP_SKIP_SIGNATURE=false
WHATSAPP_LOCALE=en
WHATSAPP_PORT=8787
WHATSAPP_PUBLIC_URL=
WHATSAPP_MCP_TOKEN=

# Cursor Cloud Agents. Required for /update to actually start an agent.
# https://cursor.com/dashboard/api
CURSOR_API_KEY=
CURSOR_REPO_URL=https://github.com/tobievii/constrAI
CURSOR_STARTING_REF=main
CURSOR_AUTO_CREATE_PR=true
